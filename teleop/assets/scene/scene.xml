<mujoco model="table_scene">
  <compiler angle="radian" autolimits="true"/>
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>

    <!-- table.xml -->
    <material name="table_top_mat" rgba="0.65 0.75 0.75 1" specular="0.05" shininess="0.05"/>
    <material name="table_leg_mat" rgba="0.65 0.42 0.22 1"/>
    <!-- frame.xml -->
    <material name="frame_metal" rgba="0.55 0.58 0.62 1"/>
    <material name="frame_rubber" rgba="0.22 0.23 0.27 1"/>
    <!-- writeboard.xml -->
    <material name="white_surface" rgba="0.85 0.85 0.85 1" specular="0.65" shininess="0.55"/>
    <material name="aluminum" rgba="0.73 0.76 0.77 1" specular="0.05" shininess="0.05"/>
    <material name="corner" rgba="0.48 0.49 0.59 1"/>
    <!-- pen.xml -->
    <material name="pen_white" rgba="0.94 0.94 0.92 1"/>
    <material name="pen_red" rgba="0.82 0.03 0.04 1"/>
    <material name="pen_black" rgba="0.08 0.08 0.08 1"/>
  </asset>

  <worldbody>
    <light name="top" pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"
          contype="1" conaffinity="1" friction="1 0.005 0.0001"/>

    <!-- Table from table.xml. -->
    <body name="table" pos="0 0 0">
      <geom name="table_top" type="box" pos="0 0 0.715" size="0.75 0.35 0.035"
            material="table_top_mat" contype="1" conaffinity="1"
            friction="1.0 0.005 0.0001"/>
      <geom name="leg_front_left" type="cylinder" pos="0.69 0.29 0.34" size="0.04 0.34"
            material="table_leg_mat" contype="1" conaffinity="1"/>
      <geom name="leg_front_right" type="cylinder" pos="0.69 -0.29 0.34" size="0.04 0.34"
            material="table_leg_mat" contype="1" conaffinity="1"/>
      <geom name="leg_back_left" type="cylinder" pos="-0.69 0.29 0.34" size="0.04 0.34"
            material="table_leg_mat" contype="1" conaffinity="1"/>
      <geom name="leg_back_right" type="cylinder" pos="-0.69 -0.29 0.34" size="0.04 0.34"
            material="table_leg_mat" contype="1" conaffinity="1"/>

      <!-- Frame from frame.xml, fixed on the tabletop (easel slope ≈ 30°). -->
      <body name="whiteboard_frame" pos="0 0 0.75">
        <geom name="frame_left_base" type="capsule"
              fromto="-0.265 -0.195 0.018 -0.265 0.195 0.018"
              size="0.012" material="frame_metal"/>
        <geom name="frame_left_slope" type="capsule"
              fromto="-0.265 -0.195 0.035 -0.265 0.195 0.26017"
              size="0.012" material="frame_metal"/>
        <geom name="frame_left_rear" type="capsule"
              fromto="-0.265 0.195 0.018 -0.265 0.195 0.26017"
              size="0.012" material="frame_metal"/>
        <geom name="frame_right_base" type="capsule"
              fromto="0.265 -0.195 0.018 0.265 0.195 0.018"
              size="0.012" material="frame_metal"/>
        <geom name="frame_right_slope" type="capsule"
              fromto="0.265 -0.195 0.035 0.265 0.195 0.26017"
              size="0.012" material="frame_metal"/>
        <geom name="frame_right_rear" type="capsule"
              fromto="0.265 0.195 0.018 0.265 0.195 0.26017"
              size="0.012" material="frame_metal"/>
        <geom name="frame_front_crossbar" type="capsule"
              fromto="-0.265 -0.195 0.018 0.265 -0.195 0.018"
              size="0.012" material="frame_metal"/>
        <geom name="frame_rear_crossbar" type="capsule"
              fromto="-0.265 0.195 0.018 0.265 0.195 0.018"
              size="0.012" material="frame_metal"/>
        <geom name="frame_bottom_lip" type="box" pos="0 -0.205 0.055"
              size="0.29 0.005 0.02" material="frame_rubber"/>
        <geom name="frame_left_front_foot" type="box" pos="-0.265 -0.195 0.008"
              size="0.025 0.025 0.008" material="frame_rubber"/>
        <geom name="frame_right_front_foot" type="box" pos="0.265 -0.195 0.008"
              size="0.025 0.025 0.008" material="frame_rubber"/>
        <geom name="frame_left_rear_foot" type="box" pos="-0.265 0.195 0.008"
              size="0.025 0.025 0.008" material="frame_rubber"/>
        <geom name="frame_right_rear_foot" type="box" pos="0.265 0.195 0.008"
              size="0.025 0.025 0.008" material="frame_rubber"/>

        <!-- Writeboard from writeboard.xml, welded to the frame (no freejoint).
             Center sits on the slope midline, offset by half thickness along the
             slope normal; Rx(+30°) aligns the board with the easel. -->
        <body name="writeboard_fixed" pos="0 -0.005 0.156245" euler="0.5235988 0 0">
          <geom name="board_collision" type="box" size="0.30 0.225 0.010"
                rgba="0 0 0 0" contype="1" conaffinity="1"
                friction="0.8 0.01 0.001"/>
          <geom name="writing_surface" type="box" size="0.282 0.207 0.001"
                pos="0 0 0.009" material="white_surface"
                contype="0" conaffinity="0"/>
          <geom name="board_frame_front" type="box" size="0.284 0.009 0.008"
                pos="0 -0.216 0" material="aluminum" contype="0" conaffinity="0"/>
          <geom name="board_frame_back" type="box" size="0.284 0.009 0.008"
                pos="0 0.216 0" material="aluminum" contype="0" conaffinity="0"/>
          <geom name="board_frame_left" type="box" size="0.009 0.207 0.008"
                pos="-0.291 0 0" material="aluminum" contype="0" conaffinity="0"/>
          <geom name="board_frame_right" type="box" size="0.009 0.207 0.008"
                pos="0.291 0 0" material="aluminum" contype="0" conaffinity="0"/>
          <geom name="board_cap_1" type="box" size="0.016 0.016 0.010"
                pos="-0.284 -0.209 0" material="corner" contype="0" conaffinity="0"/>
          <geom name="board_cap_2" type="box" size="0.016 0.016 0.010"
                pos="-0.284 0.209 0" material="corner" contype="0" conaffinity="0"/>
          <geom name="board_cap_3" type="box" size="0.016 0.016 0.010"
                pos="0.284 -0.209 0" material="corner" contype="0" conaffinity="0"/>
          <geom name="board_cap_4" type="box" size="0.016 0.016 0.010"
                pos="0.284 0.209 0" material="corner" contype="0" conaffinity="0"/>
        </body>
      </body>
    </body>

    <!-- Pen from pen.xml on the tabletop. freejoint must be a top-level
         worldbody body, so the pen sits outside the table hierarchy. -->
    <body name="pen" pos="0.45 -0.15 0.825">
      <freejoint name="pen_free"/>
      <inertial pos="0 0 0" mass="0.02" diaginertia="0.000045 0.000045 0.000001"/>
      <geom name="pen_barrel" type="cylinder" pos="0 0 -0.001" size="0.0092 0.040"
            material="pen_white" contype="1" conaffinity="1"
            friction="0.8 0.01 0.001"/>
      <geom name="pen_cap" type="cylinder" pos="0 0 0.057" size="0.010 0.018"
            material="pen_red" contype="1" conaffinity="1"/>
      <geom name="pen_rear" type="cylinder" pos="0 0 -0.0555" size="0.0085 0.0145"
            material="pen_red" contype="1" conaffinity="1"/>
      <geom name="pen_tip" type="cylinder" pos="0 0 -0.0725" size="0.0025 0.0025"
            material="pen_black" contype="1" conaffinity="1"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home" qpos="0.45 -0.15 0.825 1 0 0 0"/>
  </keyframe>
</mujoco>
